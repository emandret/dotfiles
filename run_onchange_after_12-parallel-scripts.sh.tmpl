#!/bin/bash
# shellcheck disable=SC2329

set -euxo pipefail

parallel_tasks=(
{{- $scripts := glob (printf "%s/.scripts/*.sh" .chezmoi.sourceDir) -}}
{{ range $scripts -}}
  "{{ . }}" # {{ include . | sha256sum }}
{{ end -}}
)

if ((${#parallel_tasks[@]} == 0)); then
  exit 0
fi

pids=()
last_exit_code=0

terminate_components() {
  local pid
  for pid in "${pids[@]}"; do
    kill -TERM -- "-${pid}" 2>/dev/null || true
  done
}

trap terminate_components INT TERM ERR

set -m
for s in "${parallel_tasks[@]}"; do
  "$s" &
  pids+=("$!")
done
set +m

for i in "${!parallel_tasks[@]}"; do
  name="${parallel_tasks[i]}"

  exit_code=0
  wait "${pids[i]}" || exit_code=$?

  unset "pids[i]"

  if ((exit_code != 0)); then
    echo "${name} failed: ${exit_code}" >&2
    last_exit_code=$exit_code
  else
    echo "${name} ok"
  fi
done

exit "$last_exit_code"
