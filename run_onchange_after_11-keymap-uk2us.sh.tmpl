#!/bin/bash

# {{ include "Library/LaunchAgents/private_com.user.keymap-uk2us.plist.tmpl" | sha256sum }}
# {{ include "dot_local/scripts/executable_keymap-uk2us.sh" | sha256sum }}

set -euxo pipefail

label='com.user.keymap-uk2us'
plist="${HOME}/Library/LaunchAgents/${label}.plist"
domain="gui/$(id -u)"

if [[ ! -f ${plist} ]]; then
  echo "Error: ${plist} not found" >&2
  exit 1
fi

launchctl bootout "${domain}/${label}" 2>/dev/null || true
launchctl bootstrap "${domain}" "${plist}"
