{{- $name := "Ed Mandret" -}}
{{- $email := "emandret@student.42.fr" -}}
{{- if hasKey . "name" }}{{ $name = .name }}{{ end -}}
{{- if hasKey . "email" }}{{ $email = .email }}{{ end -}}
[user]
  name = {{ $name }}
  email = {{ $email }}
[github]
  user = emandret
[url "ssh://git@github.com/emandret"]
  insteadOf = https://github.com/emandret
[init]
  defaultBranch = main
[blame]
  coloring = repeatedLines
[core]
  editor = vim
[diff]
  tool = nvimdiff
[difftool]
  prompt = true         # lets you answer "n" to skip a file
  trustExitCode = true  # makes :cq abort the run
[merge]
  tool = vimdiff
  conflictstyle = merge
[mergetool]
  prompt = false
[alias]
  tree = log --graph --oneline --all
  dt = difftool -d
[credential "https://git-codecommit.eu-west-1.amazonaws.com"]
  helper = !aws codecommit credential-helper $@
  UseHttpPath = true
{{- if eq .chezmoi.os "darwin" }}
[credential]
  helper = osxkeychain
{{- else }}
[credential]
  helper = cache --timeout=3600
{{- end }}
