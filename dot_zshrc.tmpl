typeset -U path PATH fpath FPATH manpath MANPATH
export PATH="${HOME}/bin:${HOME}/.local/bin:/usr/local/bin:${PATH}"

{{ if eq .chezmoi.os "darwin" }}
for brew_prefix in /opt/homebrew /usr/local; do
  if [[ -x "${brew_prefix}/bin/brew" ]]; then
    eval "$("${brew_prefix}/bin/brew" shellenv)"
    break
  fi
done
unset brew_prefix
{{ end }}

# -------------------------------------------------------------------------------
# OH MY ZSH

ZSH="${HOME}/.oh-my-zsh"
ZSH_THEME=robbyrussell

plugins=(
  colored-man-pages
  docker
  gitfast
  kubectl
  terraform
  zsh-syntax-highlighting
)

source "${ZSH}/oh-my-zsh.sh"

# -------------------------------------------------------------------------------
# SHELL ENVIRONMENT

export LANG=en_US.UTF-8

if [[ -n "${SSH_CONNECTION}" ]]; then
  export EDITOR=vim
else
  export EDITOR=nvim
fi

# Compilation flags
export ARCHFLAGS="-arch $(uname -m)"

# Unset MANPATH so we can inherit from /etc/manpath
unset MANPATH; export MANPATH="$(manpath)"

# Manage npm-installed node packages
if command -v npm >/dev/null; then
  # Prefix for global installs; store npm packages in the homedir (no sudo privileges needed)
  export NPM_PACKAGES="${NPM_PACKAGES:-${HOME}/.npm-packages}"

  # Let 'require()' resolve globally installed modules
  export NODE_PATH="${NPM_PACKAGES}/lib/node_modules${NODE_PATH:+:${NODE_PATH}}"

  # Add globally installed CLI packages to PATH (ahead of system ones)
  export PATH="${NPM_PACKAGES}/bin:${PATH}"

  unset MANPATH; export MANPATH="${NPM_PACKAGES}/share/man:$(manpath)"
fi

# Add GOPATH/bin to PATH for go binaries
if command -v go >/dev/null; then
  export PATH="$(go env GOPATH)/bin:${PATH}"
fi

# Add cargo-installed rust binaries to PATH
cargo_bin="${CARGO_HOME:-${HOME}/.cargo}/bin"
if [[ -d "$cargo_bin" ]]; then
  export PATH="${cargo_bin}:${PATH}"
fi
unset cargo_bin

# Tell gpg which terminal to draw the pinentry passphrase prompt on
if [[ -o interactive ]] && [[ -n "$TTY" ]] && command -v gpg >/dev/null; then
  export GPG_TTY="$TTY"
fi

# Let ansible-vault read the passphrase from disk instead of prompting
if [[ -f "${HOME}/.ansible_vault_password_file" ]]; then
  export ANSIBLE_VAULT_PASSWORD_FILE="${HOME}/.ansible_vault_password_file"
fi

# -------------------------------------------------------------------------------
# USER CONFIG

alias ip='ip -c'
alias myip='dig +short myip.opendns.com @resolver4.opendns.com'

# Needed for bash completions
autoload -U +X bashcompinit && bashcompinit

# Setup kubectl completions
if command -v kubectl >/dev/null; then
  source <(kubectl completion zsh)

  # Use kubecolor instead of kubectl
  command -v kubecolor >/dev/null && alias kubectl=kubecolor

  alias k=kubectl
  compdef __start_kubectl k
fi

# Source external config
for f in "${HOME}"/.config/zsh/*.zsh(N.); do
  source "$f"
done
